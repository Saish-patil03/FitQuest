# ==============================================================================
# FitQuest AI Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit real secrets or passwords to Git.
# ==============================================================================

# Email Provider Configuration ('smtp' or 'development')
# - 'smtp': Delivers actual emails via Gmail/SMTP (requires SMTP_USERNAME & SMTP_PASSWORD below)
# - 'development': Prints the reset link directly to backend terminal output
EMAIL_PROVIDER=smtp

# Gmail SMTP Configuration
# NOTE: Gmail SMTP requires:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character Google App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address in SMTP_USERNAME and EMAIL_FROM
# 4. Enter your 16-character App Password (without spaces) in SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Database Connection URL (SQLite Local Dev or Supabase PostgreSQL Central Database)
# - Local SQLite: sqlite:///./ai_fitness.db
# - Supabase PostgreSQL: postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./ai_fitness.db

# FitQuest JWT Secret Key (Required for User Authentication & Token Signing)
# Generate a secure 32-byte secret (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FITQUEST_SECRET_KEY=

# FitQuest Frontend Application Base URL
FITQUEST_FRONTEND_URL=http://127.0.0.1:8080

# Gemini AI API Key (Optional for AI Coach Online Mode)
GEMINI_API_KEY=

